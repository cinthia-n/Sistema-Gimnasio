generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       Int      @id @default(autoincrement())
  username String   @unique
  password String
  fullName String   @map("fullName")
  role     UserRole

  isActive           Boolean   @default(true)   @map("isActive")
  passwordChangedAt  DateTime? @map("passwordChangedAt")
  mustChangePassword Boolean   @default(false)  @map("mustChangePassword")

  createdAt DateTime @default(now())            @map("createdAt")

  cashClosings  CashClosing[]  @relation("UserCashClosings")
  cashOpenings  CashClosing[]  @relation("UserCashOpenings")
  cashMovements CashMovement[] @relation("UserCashMovements")
  payments      Payment[]
  purchases     Purchase[]
  sales         Sale[]
}

model Service {
  id             Int             @id @default(autoincrement())
  name           String
  description    String?
  type           ServiceType
  durationDays   Int
  basePrice      Decimal         @db.Decimal(10, 2)
  active         Boolean         @default(true)
  code           String          @unique
  clientServices ClientService[]
  servicePrices  ServicePrice[]
}

model Promotion {
  id           Int      @id @default(autoincrement())
  name         String
  description  String?
  price        Decimal? @db.Decimal(10, 2)
  durationDays Int
  startDate    DateTime
  endDate      DateTime
  active       Boolean  @default(true)

  clientServices ClientService[]
}

model ClientService {
  id             Int                 @id @default(autoincrement())
  clientId       Int
  serviceId      Int?
  promotionId    Int?
  membershipCode String              @unique
  startDate      DateTime
  endDate        DateTime
  basePrice      Decimal             @db.Decimal(10, 2)
  isStudent      Boolean             @default(false)
  discount       Decimal             @db.Decimal(10, 2)
  finalPrice     Decimal             @db.Decimal(10, 2)
  status         ClientServiceStatus @default(ACTIVE)
  createdAt      DateTime            @default(now())
  balanceDue     Decimal             @default(0) @db.Decimal(10, 2)
  paidAmount     Decimal             @default(0) @db.Decimal(10, 2)

  attendances Attendance[]
  client      Client       @relation(fields: [clientId], references: [id])
  promotion   Promotion?   @relation(fields: [promotionId], references: [id])
  service     Service?     @relation(fields: [serviceId], references: [id])
  payments    Payment[]
}

model Payment {
  id              Int           @id @default(autoincrement())
  userId          Int
  amount          Decimal       @db.Decimal(10, 2)
  paymentMethod   PaymentMethod
  paymentDate     DateTime      @default(now())
  clientServiceId Int
  notes           String?
  reference       String?
  status          PaymentStatus @default(PAID)
  clientService   ClientService @relation(fields: [clientServiceId], references: [id])
  user            User          @relation(fields: [userId], references: [id])
}

model Product {
  id Int @id @default(autoincrement())

  supplierId Int @map("supplierId")

  code String? @unique

  name String

  purchasePrice Decimal @map("purchasePrice") @db.Decimal(10, 2)

  stock Int @default(0)

  minimumStock Int @default(0) @map("minimumstock")

  active Boolean @default(true)

  supplier Supplier @relation(fields: [supplierId], references: [id])

  prices ProductPrice[]

  saleDetails SaleDetail[]

  purchaseDetails PurchaseDetail[]
}

model Supplier {
  id            Int        @id @default(autoincrement())
  name          String
  contactPerson String?
  phone         String?
  address       String?
  notes         String?
  createdAt     DateTime   @default(now())
  email         String?
  isActive      Boolean    @default(true)
  nit           String?
  purchases     Purchase[]
  products      Product[]
}

model Sale {
  id            Int           @id @default(autoincrement())
  saleDate      DateTime      @default(now())
  total         Decimal       @db.Decimal(10, 2)
  paymentMethod PaymentMethod
  userId        Int
  clientId      Int?
  client        Client?       @relation(fields: [clientId], references: [id])
  user          User          @relation(fields: [userId], references: [id])
  details       SaleDetail[]
}

model SaleDetail {
  id        Int     @id @default(autoincrement())
  saleId    Int
  productId Int
  quantity  Int
  unitPrice Decimal @db.Decimal(10, 2)
  subtotal  Decimal @db.Decimal(10, 2)
  product   Product @relation(fields: [productId], references: [id])
  sale      Sale    @relation(fields: [saleId], references: [id])
}

model BodyAssessment {
  id             Int      @id @default(autoincrement())
  clientId       Int
  assessmentDate DateTime @default(now())
  weight         Decimal? @db.Decimal(5, 2)
  bodyFat        Decimal? @db.Decimal(5, 2)
  muscleMass     Decimal? @db.Decimal(5, 2)
  imc            Decimal? @db.Decimal(5, 2)
  notes          String?
  client         Client   @relation(fields: [clientId], references: [id])
}

model Attendance {
  id              Int           @id @default(autoincrement())
  clientServiceId Int
  attendanceDate  DateTime      @default(now())
  notes           String?
  clientService   ClientService @relation(fields: [clientServiceId], references: [id])
}

model Purchase {
  id           Int      @id @default(autoincrement())
  supplierId   Int      @map("supplierId")
  purchaseDate DateTime @default(now())

  total Decimal @db.Decimal(10, 2)

  paymentMethod PaymentMethod?

  createdById   Int?    @map("createdById")
  invoiceNumber String? @map("invoiceNumber")
  notes         String?

  createdBy User? @relation(fields: [createdById], references: [id])

  supplier Supplier @relation(fields: [supplierId], references: [id])

  details PurchaseDetail[]
}

model PurchaseDetail {
  id         Int      @id @default(autoincrement())
  purchaseId Int
  productId  Int
  quantity   Int
  unitCost   Decimal  @db.Decimal(10, 2)
  subtotal   Decimal  @db.Decimal(10, 2)
  product    Product  @relation(fields: [productId], references: [id])
  purchase   Purchase @relation(fields: [purchaseId], references: [id])
}

model CashMovement {
  id            Int                @id @default(autoincrement())
  movementDate  DateTime           @default(now())
  type          CashMovementType
  amount        Decimal            @db.Decimal(10, 2)
  paymentMethod PaymentMethod?
  concept       String
  createdById   Int
  notes         String?
  referenceId   Int?
  referenceType CashReferenceType?
  status        CashMovementStatus @default(CONFIRMED)
  createdBy     User               @relation("UserCashMovements", fields: [createdById], references: [id])
}

model Client {
  id             Int              @id @default(autoincrement())
  fullName       String
  ci             String           @unique
  phone          String
  createdAt      DateTime         @default(now())
  active         Boolean          @default(true)
  address        String?
  birthDate      DateTime?
  gender         Gender?
  assessments    BodyAssessment[]
  clientServices ClientService[]
  sales          Sale[]
}

model CashClosing {
  id           Int               @id @default(autoincrement())
  closingDate  DateTime?
  expectedCash Decimal           @default(0) @db.Decimal(10, 2)
  countedCash  Decimal?          @db.Decimal(10, 2)
  difference   Decimal?          @db.Decimal(10, 2)
  observations String?
  closedById   Int?
  openedById   Int
  openingCash  Decimal           @db.Decimal(10, 2)
  openingDate  DateTime          @default(now())
  status       CashClosingStatus @default(OPEN)
  closedBy     User?             @relation("UserCashClosings", fields: [closedById], references: [id])
  openedBy     User              @relation("UserCashOpenings", fields: [openedById], references: [id])
}

model ProductPrice {
  id Int @id @default(autoincrement())

  productId Int

  type ProductPriceType

  price Decimal @db.Decimal(10, 2)

  minimumQuantity Int @default(1)

  product Product @relation(fields: [productId], references: [id])
}

model ServicePrice {
  id Int @id @default(autoincrement())

  serviceId Int
  isStudent Boolean

  price Decimal @db.Decimal(10, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  service Service @relation(fields: [serviceId], references: [id])

  @@unique([serviceId, isStudent])
}

enum UserRole {
  ADMIN
  EMPLOYEE
}

enum PaymentMethod {
  CASH
  QR
}

enum ServiceType {
  MEMBERSHIP
  PROGRAM
  ADDITIONAL
}

enum ClientServiceStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum CashMovementType {
  INCOME
  EXPENSE
}

enum CashMovementStatus {
  CONFIRMED
  CANCELLED
}

enum CashReferenceType {
  MEMBERSHIP_PAYMENT
  PRODUCT_SALE
  PURCHASE
  OTHER_EXPENSE
}

enum Gender {
  MALE
  FEMALE
}

enum PaymentStatus {
  PAID
  PENDING
  CANCELLED
}

enum ProductCategory {
  SUPPLEMENT
  DRINK
  SNACK
  ACCESSORY
  CLOTHING
}

enum CashClosingStatus {
  OPEN
  CLOSED
}

enum ProductPriceType {
  MINORISTA

  MAYORISTA
}
